				"code" : "requestAndResult := ((#url: // 'https://api.timezonedb.com' / 'v2.1' / 'list-time-zone')\r\t\tparameterAt: #key put: #vault: // #worldclock / #apikey;\r\t\tparameterAt: #format put: 'json';\r\t\tuseGET)\r\t\t\t\t\t\tpayload: [ :root | root at: 'zones' ];\r\t\t\t\t\t\tpayload: ((TTPayloadModifier new) \r\t\t\t\t\t\t             key: #timestamp; \r\t\t\t\t\t\t             modify: [ :seconds | DateAndTime fromUnixTime:  seconds]);\r\t\t\t\t\t\t             \r\t\t\t\t\t\tmapping: ((TTMap new) \r\t\t\t\t\t\t\t\t\t\t\t\t prototype: (TTModel new keyField: #zoneName);\r\t\t\t\t\t\t\t           into: (SortedCollection sortBlock: [ :a :b | b key <= a key ]));\r\t\t\t\t\t\t\t           \r\t\t\t\t\t\tformat: [ :list | list select: [ :each | each key beginsWith: 'Europe' ] ];\r\t\t\t\t\t\t\r\t\t\t\t\t\tyourself"
			},
