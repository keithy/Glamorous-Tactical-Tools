					"uidString" : "HGF0HasOQk26gf3/to4pHA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## The Current Winner\n\nNow you can discover the most useful tools and registries from a logical place."
