						"dateAndTimeString" : "2026-07-30T00:00:45.068433+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "ttuppMGmRmqqdn1aqN+/EA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## The Current Winner\n\nProvides utilitiy methods and a starting point for looking around. Most importantly those things that always have to search in TheBook are right here.\n"
