# This passthrough into the default dicitonary
Preserve_My_Case_Please=keep_me
SOME_LLM_API_KEY=my_key
__Problem_Child=problem_value
__MISE_EXE=/usr/local/bin/mise

# default namespace (option=default, app=jira, field=credential)
JIRA__URL=https://jira.example.com
JIRA__USER=alice
JIRA__EMAIL=alice@example.com
JIRA__PASS=secret
JIRA__API_KEY=ak_live_xyz

# default namespace, app=gitlab_saas (whole-app host naming)
GITLAB_SAAS__URL=https://gitlab.com
GITLAB_SAAS__USER=alice
alice__GITLAB_SAAS__TOKEN=glpat-1234567890
mary__GITLAB_SAAS__TOKEN=glpat-1234567890

# default namespace, app=gitlab_onprem
default__GITLAB_ONPREM__URL=https://gitlab.internal.example.com
default__GITLAB_ONPREM__USER=alice
default__GITLAB_ONPREM__TOKEN=glpat-internal-abcdef

# default namespace, app=my_cool_app (underscores allowed in app name)
MY_COOL_APP__TOKEN=ok

# host2 namespace (option=host2, app=jira, field=credential)
host2__JIRA__USER=bob
host2__JIRA__TOKEN=tok_2
