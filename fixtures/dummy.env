# default host (no prefix)
JIRA_URL=https://jira.example.com
JIRA_USER=alice
JIRA_EMAIL=alice@example.com
JIRA_PASS=secret
JIRA_API_KEY=ak_live_xyz

# GITLAB_SAAS_ prefix
GITLAB_SAAS_URL=https://gitlab.com
GITLAB_SAAS_USER=alice
GITLAB_SAAS_TOKEN=glpat-1234567890

# GITLAB_ONPREM_ prefix
GITLAB_ONPREM_URL=https://gitlab.internal.example.com
GITLAB_ONPREM_USER=alice
GITLAB_ONPREM_TOKEN=glpat-internal-abcdef

# host-prefixed variant of JIRA_USER for a second host
host2__JIRA_USER=bob
host2__JIRA_TOKEN=tok_2

# an underscore-bearing app name to test the ambiguity we warned about
MY_COOL_APP_TOKEN=ok
